# ===========================================
# AntiGrind Backend Environment Configuration
# ===========================================

# 环境标识: development | staging | production
ENVIRONMENT=development
DEBUG=true

# ---- 数据库配置 ----
# 开发环境使用SQLite（无需安装PostgreSQL）
DATABASE_URL=sqlite+aiosqlite:///./antigrind.db
# 生产环境使用PostgreSQL:
# DATABASE_URL=postgresql+asyncpg://user:password@db:5432/antigrind

# ---- Redis 缓存 ----
REDIS_URL=redis://localhost:6379/0

# ---- Neo4j 图数据库 ----
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=password

# ---- Meilisearch 搜索引擎 ----
MEILISEARCH_URL=http://localhost:7700
MEILISEARCH_API_KEY=

# ---- MinIO 对象存储 ----
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=evidences
MINIO_SECURE=false

# ---- 安全配置 (重要!) ----
# CORS允许的域名（逗号分隔），生产环境请明确指定，不要用*
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# JWT签名密钥 - ⚠️ 生产环境必须设置为强随机密钥（至少32字符）
# 可以使用命令生成: python -c "import secrets; print(secrets.token_urlsafe(32))"
JWT_SECRET_KEY=
# 如果留空，开发环境会自动生成（仅用于开发！）
