# ===========================================
# 🚀 生产环境配置 (Production)
# ⚠️  重要：所有敏感信息必须设置！
# ===========================================

# 环境标识
ENVIRONMENT=production
DEBUG=false

# ---- 数据库配置（必须使用PostgreSQL）----
DATABASE_URL=postgresql+asyncpg://user:password@db-host:5432/antigrind_prod
# 示例: postgresql+asyncpg://antigrind:StrongPassword123@prod-db.internal:5432/antigrind

# ---- Redis 缓存（生产环境必须启用）----
REDIS_URL=redis://redis-cluster:6379/0
# Redis密码（如果启用了认证）
# REDIS_PASSWORD=your-redis-password

# ---- Neo4j 图数据库（可选，用于高级分析）----
NEO4J_URI=bolt://neo4j-prod:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=your-strong-neo4j-password

# ---- Meilisearch 搜索引擎（推荐启用）----
MEILISEARCH_URL=http://meilisearch:7700
MEILISEARCH_API_KEY=your-meilisearch-master-key

# ---- MinIO 对象存储（用于文件上传）----
MINIO_ENDPOINT=minio.prod.internal
MINIO_ACCESS_KEY=minio-admin
MINIO_SECRET_KEY=your-minio-secret-key-change-this
MINIO_BUCKET=antigrind-evidences
MINIO_SECURE=true

# ---- 🔒 安全配置（生产环境必填！）----

# CORS允许的域名（逗号分隔，不要用*）
CORS_ORIGINS=https://app.antigrind.com,https://admin.antigrind.com,https://api.antigrind.com

# JWT签名密钥（⚠️ 必须设置为强随机密钥）
# 生成命令: python -c "import secrets; print(secrets.token_urlsafe(32))"
JWT_SECRET_KEY=CHANGE-THIS-TO-A-STRONG-RANDOM-KEY-AT-LEAST-32-CHARS!!!
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=10080  # 7天

# ---- 性能调优（生产环境建议值）----
# 数据库连接池大小
DB_POOL_SIZE=20
DB_MAX_OVERFLOW=10

# Redis连接超时
REDIS_TIMEOUT=5

# API速率限制（更严格）
RATE_LIMIT_AUTH=10/minute
RATE_LIMIT_API=60/minute
RATE_LIMIT_SEARCH=30/minute

# ---- 监控与日志（生产环境推荐）----
LOG_LEVEL=INFO
LOG_FORMAT=json
SENTRY_DSN=https://xxxxx@sentry.io/xxxxx  # 可选：错误追踪

# ---- 邮件服务（用于通知）----
SMTP_HOST=smtp.sendgrid.net
SMTP_PORT=587
SMTP_USER=apikey
SMTP_PASSWORD=your-sendgrid-api-key
SMTP_FROM_EMAIL=noreply@antigrind.com
SMTP_FROM_NAME=AntiGrind
